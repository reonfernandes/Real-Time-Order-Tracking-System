# Copy this file as .env and fill in your own values.
# .env is git ignored, never commit the real one.

# gmail account used for sending order mails, password is the 16 char app password
MAIL_USERNAME=yourmail@gmail.com
MAIL_PASSWORD=your_app_password
EMAIL_SENDER=yourmail@gmail.com

# base64url encoded secret, keep it long enough for HS256
JWT_SECRET=replace_with_your_own_base64url_secret
# token validity in milliseconds, 3600000 is one hour
EXPIRATION_TIME=3600000

# frontend urls allowed to call the api, comma separated
CORS_ALLOWED_ORIGINS=http://localhost:3000

# jwt cookie flags. Leave these alone for localhost.
# Set COOKIE_SECURE=false only if you deploy over plain http, otherwise the browser
# drops the cookie and the live order stream cannot authenticate.
COOKIE_SECURE=true
# use None (together with COOKIE_SECURE=true) when the ui and the api are on different sites
COOKIE_SAME_SITE=Strict
